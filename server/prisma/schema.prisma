generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// These fields are kept as plain Strings (constrained by the zod schemas in
// each route handler) rather than native Postgres enums, so the app code
// didn't need to change when the datasource moved from SQLite to Postgres:
//   AccountType:  BANK | CREDIT_CARD
//   CategoryType: INCOME | EXPENSE | TRANSFER
//   MatchType:    CONTAINS | STARTS_WITH | REGEX | EXACT
//   TransferType: ACCOUNT_TRANSFER | GROUP_REALLOCATION
//   AssetType:    FIXED_DEPOSIT | MUTUAL_FUND | EPF | PPF | GOLD | CASH | REAL_ESTATE | VEHICLE | CRYPTO | OTHER
//   LiabilityType: HOME_LOAN | PERSONAL_LOAN | GOLD_LOAN | VEHICLE_LOAN | CREDIT_CARD | OTHER

// A bank account or credit card. Balances are never stored directly on the
// account - they are derived from the opening balances + transactions of
// its Groups, so a "multi-purpose" account is just an account with more
// than one Group.
model Account {
  id            String        @id @default(cuid())
  name          String
  type          String
  institution   String?
  last4         String?
  currency      String        @default("INR")
  creditLimit   Float?
  isMultiPurpose Boolean      @default(false)
  // Remembers the last CSV column mapping + target group used for this
  // account's imports, so re-importing a statement from the same bank
  // doesn't require re-picking columns every time. JSON-encoded ColumnMapping.
  lastImportMapping String?
  lastImportGroupId String?
  archived      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  groups        Group[]
  transactions  Transaction[]
  importBatches ImportBatch[]
  goals         Goal[]
}

// A fund/purpose flag scoped to one account, e.g. "Personal" and
// "Temple Fund" both living inside the same ICICI account. Every
// transaction belongs to exactly one group. Every account gets a
// "General" default group automatically.
model Group {
  id             String        @id @default(cuid())
  name           String
  color          String?
  accountId      String
  account        Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  isDefault      Boolean       @default(false)
  openingBalance Float         @default(0)
  archived       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  transactions   Transaction[]

  @@unique([accountId, name])
}

model Category {
  id           String         @id @default(cuid())
  name         String         @unique
  type         String
  color        String?
  icon         String?
  isSystem     Boolean        @default(false)
  parentId     String?
  parent       Category?      @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[]     @relation("CategoryHierarchy")
  rules        CategoryRule[]
  transactions Transaction[]
  budgets      Budget[]
  bills        Bill[]
}

model CategoryRule {
  id         String       @id @default(cuid())
  pattern    String
  matchType  String       @default("CONTAINS")
  amountSign String       @default("ANY") // ANY | DEBIT | CREDIT
  priority   Int          @default(0)
  isActive   Boolean      @default(true)
  categoryId String
  category   Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
}

model Transaction {
  id             String       @id @default(cuid())
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  groupId        String
  group          Group        @relation(fields: [groupId], references: [id])
  date           DateTime
  description    String
  rawDescription String?
  amount         Float        // positive = inflow/credit, negative = outflow/debit
  categoryId     String?
  category       Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  notes          String?
  isTransfer     Boolean      @default(false)
  transferId     String?
  transfer       Transfer?    @relation(fields: [transferId], references: [id], onDelete: SetNull)
  importBatchId  String?
  importBatch    ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  dedupeKey      String?      // hash of date+description+amount, used to skip duplicate imports
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([accountId, date])
  @@index([groupId])
  @@index([categoryId])
  @@unique([accountId, dedupeKey])
}

// One Transfer groups the 2 Transaction legs it creates - either moving
// real money between two Accounts, or reallocating funds between two
// Groups inside the same Account (net zero at the account level).
model Transfer {
  id           String        @id @default(cuid())
  type         String
  date         DateTime
  amount       Float
  note         String?
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

model ImportBatch {
  id                String        @id @default(cuid())
  accountId         String
  account           Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  filename          String
  importedAt        DateTime      @default(now())
  rowCount          Int
  skippedDuplicates Int           @default(0)
  transactions      Transaction[]
}

// A non-transactional holding that contributes to net worth - fixed deposits,
// mutual funds, EPF/PPF, gold, real estate, etc. Unlike Account/Transaction,
// there's no ledger here: currentValue is just overwritten as the user (or,
// later, a market-data sync) refreshes it. updatedAt doubles as "last updated".
model Asset {
  id            String   @id @default(cuid())
  name          String
  type          String
  currentValue  Float
  purchaseValue Float?
  notes         String?
  archived      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  goals         Goal[]
}

// A loan or other debt tracked outside the Account model (which already
// covers credit cards with transaction-level detail). Contributes negatively
// to net worth alongside credit card account balances.
model Liability {
  id                 String    @id @default(cuid())
  name               String
  type               String
  outstandingBalance Float
  interestRate       Float?
  emiAmount          Float?
  nextDueDate        DateTime?
  lender             String?
  notes              String?
  archived           Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// A recurring spending limit for one category - amount is the limit for
// whatever period is chosen; "spent" for the current period is computed on
// read from Transactions rather than stored, so editing the amount just
// changes the limit going forward without needing per-month rows (mirrors
// how Asset.currentValue is a single live figure, not a ledger).
model Budget {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amount     Float
  period     String   @default("MONTHLY")
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// A recurring expense (EMI, insurance, rent, subscription) tracked so the
// Dashboard can surface what's coming up. nextDueDate is rolled forward by
// `recurrence` on read once it's in the past (see services/bills.ts) - same
// upsert-on-read shape as NetWorthSnapshot - so there's no cron keeping it
// current and no risk of it silently going stale.
model Bill {
  id           String    @id @default(cuid())
  name         String
  amount       Float
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  nextDueDate  DateTime
  recurrence   String    @default("MONTHLY")
  autoDetected Boolean   @default(false)
  archived     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// A savings target the user is tracking towards (emergency fund, vacation,
// home down payment, etc). currentAmount is a manually-updated figure like
// Asset.currentValue - the optional linkedAccount/linkedAsset is just a
// reference shown alongside the goal (e.g. "tracked via this FD"), not an
// auto-synced balance, so progress stays predictable even if the linked
// entity is later archived or its balance moves for unrelated reasons.
model Goal {
  id              String    @id @default(cuid())
  name            String
  targetAmount    Float
  currentAmount   Float     @default(0)
  targetDate      DateTime?
  linkedAccountId String?
  linkedAccount   Account?  @relation(fields: [linkedAccountId], references: [id], onDelete: SetNull)
  linkedAssetId   String?
  linkedAsset     Asset?    @relation(fields: [linkedAssetId], references: [id], onDelete: SetNull)
  archived        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// One row per calendar day the net worth breakdown was computed, upserted
// on read (see services/netWorth.ts) rather than on a cron - this is what
// powers the Net Worth Trend chart, and it builds up history organically
// from the day this feature shipped without needing a scheduler.
model NetWorthSnapshot {
  id           String   @id @default(cuid())
  date         DateTime @unique
  cashAndBank  Float
  investments  Float
  retirement   Float
  otherAssets  Float
  liabilities  Float
  netWorth     Float
  createdAt    DateTime @default(now())
}
